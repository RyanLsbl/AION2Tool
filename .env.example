# Kopiere diese Datei nach .env und trage deine Werte ein.
# Wichtig: Hinter einem Wert keine Kommentare schreiben.

# ===== Pflicht =====
# Oeffentliche Adresse des Tools, so wie sie im Browser steht (ohne / am Ende).
# Muss exakt stimmen, sonst schlaegt der Steam-Login fehl.
PUBLIC_URL=https://aion2.domain.de

# Port, auf dem das Tool lauscht (nginx Proxy Manager leitet hierhin weiter)
PORT=1234

# Steam-IDs (17-stellig, SteamID64) der Haupt-Admins, mit Komma getrennt.
# Haupt-Admins koennen im Tool weitere Offiziere ernennen.
ADMIN_STEAM_IDS=

# ===== Empfohlen =====
# Steam-Web-API-Key fuer Steam-Name und Avatar: https://steamcommunity.com/dev/apikey
# Ohne Key funktioniert alles, die Leute heissen dann nur "Steam-User ...1234".
STEAM_API_KEY=

# ===== Optional =====
# Netzwerk-Adresse, auf der gelauscht wird (0.0.0.0 = alle; 127.0.0.1 = nur dieser Rechner)
HOST=0.0.0.0

# Speicherort der Datenbank
DB_PATH=./data/aion2tool.sqlite

# AION2-Server und Legion (PlayNC: Ishtar, EU = 1319)
AION_SERVER=Ishtar
AION_SERVER_ID=1319
AION_REGION=eu
AION_LEGION=Altersheim

# Reset-Zeiten: Uhrzeit + Zeitzone (IANA, z. B. UTC oder Europe/Berlin) und Weekly-Wochentag (0 = Sonntag, 3 = Mittwoch)
RESET_TIME=07:00
RESET_TIMEZONE=UTC
RESET_WEEKDAY=3

# Wie oft Charakterwerte bei PlayNC aktualisiert werden (Stunden; Twinks halb so oft)
REFRESH_HOURS=6

# Legions-Pruefung: an oder aus (aus = jeder Steam-Account hat Zugang - nur zum Testen!)
LEGION_CHECK=an

# Test-Login ohne Steam. Wirkt nur, wenn PUBLIC_URL auf http://localhost zeigt.
DEV_LOGIN=aus
